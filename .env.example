# Local runtime configuration. Copy to .env and fill in.
#
# Only the DASHSCOPE_* values are secrets; everything else has a sane default.
# .env is git-ignored on purpose — never commit a real key.

# --- process ---------------------------------------------------------------
# AM_DATA_DIR=data
# AM_PORT=8317
# AM_LOG_LEVEL=INFO

# --- media toolchain -------------------------------------------------------
# Only set these when ffmpeg is not on PATH.
# AM_FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
# AM_FFPROBE_PATH=C:\ffmpeg\bin\ffprobe.exe

# --- Aliyun Bailian (required for transcription) ---------------------------
DASHSCOPE_API_KEY=
# Beijing region: leave empty unless your account uses a dedicated workspace domain.
DASHSCOPE_WORKSPACE_ID=
